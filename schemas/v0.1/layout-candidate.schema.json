{
  "$defs": {
    "AreaGeometry": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "items": {
            "$ref": "#/$defs/WorldPoint"
          },
          "minItems": 3,
          "title": "Boundary",
          "type": "array"
        },
        "type": {
          "const": "area",
          "default": "area",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "boundary"
      ],
      "title": "AreaGeometry",
      "type": "object"
    },
    "BandGeometry": {
      "additionalProperties": false,
      "properties": {
        "centerline": {
          "items": {
            "$ref": "#/$defs/WorldPoint"
          },
          "minItems": 2,
          "title": "Centerline",
          "type": "array"
        },
        "type": {
          "const": "band",
          "default": "band",
          "title": "Type",
          "type": "string"
        },
        "width_profile": {
          "items": {
            "$ref": "#/$defs/WidthSample"
          },
          "minItems": 2,
          "title": "Width Profile",
          "type": "array"
        }
      },
      "required": [
        "centerline",
        "width_profile"
      ],
      "title": "BandGeometry",
      "type": "object"
    },
    "CorridorGeometry": {
      "additionalProperties": false,
      "properties": {
        "centerline": {
          "items": {
            "$ref": "#/$defs/WorldPoint"
          },
          "minItems": 2,
          "title": "Centerline",
          "type": "array"
        },
        "type": {
          "const": "corridor",
          "default": "corridor",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "centerline"
      ],
      "title": "CorridorGeometry",
      "type": "object"
    },
    "PlacementReservation": {
      "additionalProperties": false,
      "properties": {
        "allowed_region": {
          "$ref": "#/$defs/RegionSet"
        },
        "final_shape": {
          "const": "point",
          "default": "point",
          "title": "Final Shape",
          "type": "string"
        },
        "source_constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Constraints",
          "type": "array"
        }
      },
      "required": [
        "allowed_region"
      ],
      "title": "PlacementReservation",
      "type": "object"
    },
    "PointGeometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "point",
          "default": "point",
          "title": "Type",
          "type": "string"
        },
        "x_km": {
          "minimum": 0.0,
          "title": "X Km",
          "type": "number"
        },
        "y_km": {
          "minimum": 0.0,
          "title": "Y Km",
          "type": "number"
        }
      },
      "required": [
        "x_km",
        "y_km"
      ],
      "title": "PointGeometry",
      "type": "object"
    },
    "RegionPolygon": {
      "additionalProperties": false,
      "properties": {
        "holes": {
          "default": [],
          "items": {
            "items": {
              "$ref": "#/$defs/WorldPoint"
            },
            "type": "array"
          },
          "title": "Holes",
          "type": "array"
        },
        "outer": {
          "items": {
            "$ref": "#/$defs/WorldPoint"
          },
          "minItems": 3,
          "title": "Outer",
          "type": "array"
        }
      },
      "required": [
        "outer"
      ],
      "title": "RegionPolygon",
      "type": "object"
    },
    "RegionSet": {
      "additionalProperties": false,
      "properties": {
        "polygons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RegionPolygon"
          },
          "title": "Polygons",
          "type": "array"
        },
        "type": {
          "const": "region_set",
          "default": "region_set",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "RegionSet",
      "type": "object"
    },
    "SourcePlanRef": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "minLength": 1,
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "fingerprint"
      ],
      "title": "SourcePlanRef",
      "type": "object"
    },
    "WidthSample": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "T",
          "type": "number"
        },
        "width_km": {
          "exclusiveMinimum": 0.0,
          "title": "Width Km",
          "type": "number"
        }
      },
      "required": [
        "t",
        "width_km"
      ],
      "title": "WidthSample",
      "type": "object"
    },
    "WorldPoint": {
      "additionalProperties": false,
      "properties": {
        "x_km": {
          "minimum": 0.0,
          "title": "X Km",
          "type": "number"
        },
        "y_km": {
          "minimum": 0.0,
          "title": "Y Km",
          "type": "number"
        }
      },
      "required": [
        "x_km",
        "y_km"
      ],
      "title": "WorldPoint",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_index": {
      "minimum": 0,
      "title": "Attempt Index",
      "type": "integer"
    },
    "geometry_realizations": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "area": "#/$defs/AreaGeometry",
            "band": "#/$defs/BandGeometry",
            "corridor": "#/$defs/CorridorGeometry",
            "point": "#/$defs/PointGeometry"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/PointGeometry"
          },
          {
            "$ref": "#/$defs/CorridorGeometry"
          },
          {
            "$ref": "#/$defs/BandGeometry"
          },
          {
            "$ref": "#/$defs/AreaGeometry"
          }
        ]
      },
      "title": "Geometry Realizations",
      "type": "object"
    },
    "layout_version": {
      "const": "0.1",
      "title": "Layout Version",
      "type": "string"
    },
    "placement_reservations": {
      "additionalProperties": {
        "$ref": "#/$defs/PlacementReservation"
      },
      "title": "Placement Reservations",
      "type": "object"
    },
    "source_plan": {
      "$ref": "#/$defs/SourcePlanRef"
    }
  },
  "required": [
    "layout_version",
    "source_plan",
    "attempt_index"
  ],
  "title": "LayoutCandidate",
  "type": "object"
}
